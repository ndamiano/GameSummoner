# Copy to .env and edit. Loaded by docker-compose (env_file) into the app container.
# NO real secrets in this file — .env is gitignored; .env.example is committed as a template.

# ── Server ────────────────────────────────────────────────────────────────────
# Host port published by compose (container always listens on 8000 internally).
PORT=8000
# run.py binds this inside the container. 0.0.0.0 is correct — Docker maps the port.
HOST=0.0.0.0
# MAESTRO_DEV unset == production (uvicorn reload OFF). Set to 1 ONLY for local iteration.
# MAESTRO_DEV=

# Comma-separated browser origins allowed to call the API. Blank = the local dev servers
# (localhost:5173, localhost:3000). Same-origin serving (SPA + API from one process) needs none of
# them; set this only when the SPA is served from a DIFFERENT origin.
MAESTRO_CORS_ORIGINS=

# ── Durable state ─────────────────────────────────────────────────────────────
# Generated artifacts (runs/). The sqlite dbs live under MAESTRO_DATA_DIR, which compose sets to
# /data. MUST stay /data — the named Docker volume mounts here. Changing this off the volume path
# silently drops persistence.
WORKING_DIRECTORY=/data
# A queued job nobody claims for this long is failed by the reaper (seconds).
MAESTRO_STALE_PENDING_SECONDS=1800

# ── Inference: the worker-pull queue ──────────────────────────────────────────
# The control plane never calls a GPU directly — the queue is the ONLY transport, for llm, image
# and mesh alike, so a worker per queue is mandatory. Worker agents (worker/agent.py, running
# wherever the GPUs are) claim jobs over /worker, authed by this shared token:
#   python -m worker.agent --server <this box> --target <its local llama.cpp> --token <token>
WORKQUEUE_TOKEN=
# How long an enqueuer waits for a job result / how long a claim survives missed heartbeats.
WORKQUEUE_JOB_TIMEOUT=900
WORKQUEUE_LEASE=120

# ── Model config (rides in each queued request; the worker's server executes it) ──
# The model id the worker's inference server actually serves.
LLM_MODEL=local-model
# The worker server's context window (llama-server -c) — prompt budgeting trims against this.
LLM_N_CTX=32768
# Engine launch flags: llm.sglang_args reaches an llm pod at create, llm.basalt_args the local
# leg at start.
SGLANG_ARGS=
BASALT_ARGS=
# Reasoning effort: none | low | medium | xhigh, as the loaded chat template exposes them. It
# reaches the engine as `reasoning_effort`, so "none" turns thinking OFF.
LLM_REASONING=medium

# ── Asset backends ────────────────────────────────────────────────────────────
# No endpoints here: ComfyUI and TRELLIS are reached only by their `image` / `mesh` workers, which
# name their own backend with --target.

# Backups need no env vars — DB snapshots and run archives both read the `s3` block in
# src/config/settings.json (docs/backups.md).
